# Runtime only. Never copy these values into the browser extension or task-center frontend.
MODEL_PROVIDER=openai_compatible
ENABLE_FIXTURE_PROVIDER=false
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=

# Node A profiles for D6 A/B testing:
# quality  = strongest correctness baseline
# fast     = original DeepSeek latency baseline
# wire     = fast-v2 + lossless model-facing evidence compaction
# wire2    = proven cost/speed baseline: wire-v1 + compact ResourcePlan keys
# pipeline = wire2 semantics/model + Runtime-owned transport pruning, compact request keys,
#            deterministic output fields, fixed protocol placement and longer HTTP keep-alive
# latency  = wire2 protocol unchanged, but swaps only the model for model-only latency A/B
NODE_A_PROFILE=quality
# Used only when NODE_A_PROFILE=latency.
NODE_A_LATENCY_MODEL=qwen-flash
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=120
MODEL_WRITE_TIMEOUT_SECONDS=30
MODEL_MAX_COMPLETION_TOKENS=4096

# For Alibaba Cloud Model Studio, use the endpoint matching your region/key.
# Beijing public endpoint:
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Stage D6 bounded in-memory ResourcePlan cache.
PLAN_CACHE_TTL_SECONDS=1200
PLAN_CACHE_MAX_ENTRIES=64

RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8765
LOG_LEVEL=INFO

# Explicit development-only fallback:
# MODEL_PROVIDER=fixture
# ENABLE_FIXTURE_PROVIDER=true
