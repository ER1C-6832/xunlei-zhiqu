# Runtime only. Never copy model-provider credentials into the browser extension or task-center frontend.
# API supplier/dialect is independent from NODE_A_PROFILE and MODEL_NAME.
# Supported: openai | dashscope | openai_compatible | fixture
MODEL_PROVIDER=openai_compatible
ENABLE_FIXTURE_PROVIDER=false
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=

# Node A protocol/transport profiles owned by 迅雷智取.
# quality     = strongest generic correctness baseline
# fast        = shorter prompt/output baseline
# wire        = fast + lossless model-facing evidence compaction
# wire2       = proven Stage D cost/speed baseline
# pipeline    = stable pipeline v2 rollback profile
# pipeline_v3 = Wave B recommended profile for the tested DashScope + deepseek-v4-flash path;
#               keeps v2 available for rollback and should be re-benchmarked on other providers/models.
NODE_A_PROFILE=quality
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=120
MODEL_WRITE_TIMEOUT_SECONDS=30
MODEL_MAX_COMPLETION_TOKENS=4096

# E0.10 streaming is diagnostic only: the UI still receives only a fully parsed,
# normalized, Pydantic-validated and deterministically checked ResourcePlan.
MODEL_STREAM_DIAGNOSTICS=false
# Wave B found no stable HTTP/2 latency advantage. Keep false in the product path;
# enable only for an explicit endpoint/proxy benchmark.
MODEL_HTTP2_ENABLED=false

# Alibaba Cloud Model Studio example (Wave B tested configuration):
# MODEL_PROVIDER=dashscope
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=deepseek-v4-flash
# NODE_A_PROFILE=pipeline_v3

# Stage D6 bounded in-memory ResourcePlan cache.
PLAN_CACHE_TTL_SECONDS=1200
PLAN_CACHE_MAX_ENTRIES=64

RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8765
# Add the Task Center origin here when it is hosted separately from Runtime.
RUNTIME_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8765,http://localhost:8765

# E0.9 client-session seam. Demo stays open by default.
# Supported: off | static_token
RUNTIME_AUTH_MODE=off
# When RUNTIME_AUTH_MODE=static_token, set a local client-session token here and
# configure the same value as VITE_RUNTIME_SESSION in the Demo clients.
RUNTIME_STATIC_SESSION_TOKEN=

LOG_LEVEL=INFO

# Explicit development-only model fallback:
# MODEL_PROVIDER=fixture
# ENABLE_FIXTURE_PROVIDER=true
