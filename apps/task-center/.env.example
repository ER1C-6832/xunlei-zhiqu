# Public deployment setting only. Never put a model/API key in the Task Center.
# Development default is http://127.0.0.1:8765.
# Production build defaults to window.location.origin when this is omitted.
# Set this only when Task Center and local service are hosted on different origins.
# VITE_RUNTIME_URL=https://runtime.example.com

# Optional local client-session fixture. Leave empty while RUNTIME_AUTH_MODE=off.
# This is not a model-provider credential.
VITE_RUNTIME_SESSION=

# Stage-B visual fixtures are explicit and independent from Runtime DOWNLOAD_EXECUTOR.
# Keep false for real task-center use; enable together with TASK_FIXTURES_ENABLED=true
# only when intentionally reviewing fixture UI.
VITE_TASK_CENTER_FIXTURES=false
