# Public deployment settings only. Never put a model/API key in the extension.

# Current Demo transport endpoint. Product UI never reads this directly.
VITE_RUNTIME_URL=http://127.0.0.1:8765

# Optional E0.9 Runtime client-session fixture. Leave empty while Runtime auth is off.
# This is a client session token, never a model-provider API key.
VITE_RUNTIME_SESSION=

# E0.2 capability fixture. This changes capability decisions only; it does not
# implement or switch to a real ClientTransport / CloudAnalysisTransport yet.
# Allowed: demo_local | client_runtime | cloud_analysis | local_only
VITE_ZHIQU_CAPABILITY_MODE=demo_local

# E0.3 logical analysis-credential fixture. The product only sees this logical
# credential kind; it is not serialized into CaptureBatch or CloudAnalysisRequest.
# Allowed: demo | anonymous | client_session | web_session | guest_trial | none
VITE_ZHIQU_ANALYSIS_CREDENTIAL=demo

# For a later remote Runtime/Gateway build, override the public HTTPS origin, e.g.
# VITE_RUNTIME_URL=https://runtime.example.com
